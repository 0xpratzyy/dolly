{
  "name": "dolly-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prep": "bash scripts/prep-media.sh",
    "dev": "npm run prep && vite",
    "build": "npm run prep && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "deploy:dev": "npm run build && wrangler deploy -c wrangler.dev.jsonc",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@remotion/layout-utils": "4.0.534",
    "@remotion/player": "4.0.534",
    "lucide-react": "0.468.0",
    "posthog-js": "1.438.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
