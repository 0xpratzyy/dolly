{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: dolly.refs.video (live since 2026-11-25, owner: "do everything public we are going live").
  // wrangler.dev.jsonc is the private review copy on workers.dev.
  "name": "dolly-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "dolly.refs.video", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/demo/*", "/spot/*", "/narrate/*", "/hero/*", "/ingest/*"]
  }
}
