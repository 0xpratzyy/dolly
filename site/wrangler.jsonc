{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production config for later. Deliberately has no route: attach dolly.refs.video only when the owner says so, by
  // uncommenting the line below. Until then use wrangler.dev.jsonc (dolly-site-dev on workers.dev).
  "name": "dolly-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // "routes": [{ "pattern": "dolly.refs.video", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/demo/*", "/spot/*", "/narrate/*", "/hero/*", "/ingest/*"]
  }
}
